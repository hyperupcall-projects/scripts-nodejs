{
	"name": "@hyperupcall/scripts-nodejs",
	"version": "0.16.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/hyperupcall-projects/scripts-nodejs"
	},
	"bugs": {
		"url": "https://github.com/hyperupcall-projects/scripts-nodejs/issues"
	},
	"author": "Edwin Kofler <edwin@kofler.dev> (https://edwinkofler.com)",
	"private": false,
	"packageManager": "pnpm@12.23.0",
	"bin": {
		"hyperupcall-scripts-nodejs": "./scripts-nodejs.js"
	},
	"exports": {
		"./config-commitlint.js": {
			"types": "./config-commitlint.d.ts",
			"import": "./config-commitlint.js"
		},
		"./config-eslint.js": {
			"types": "./config-eslint.d.ts",
			"import": "./config-eslint.js"
		},
		"./config-markdownlint.mjs": {
			"types": "./config-markdownlint.d.mts",
			"import": "./config-markdownlint.mjs"
		},
		"./config-npmpackagejsonlint.js": {
			"types": "./config-npmpackagejsonlint.d.ts",
			"import": "./config-npmpackagejsonlint.js"
		},
		"./config-prettier.js": {
			"types": "./config-prettier.d.ts",
			"import": "./config-prettier.js"
		}
	},
	"files": [
		"./config-commitlint.d.ts",
		"./config-commitlint.js",
		"./config-eslint.d.ts",
		"./config-eslint.js",
		"./config-markdownlint.d.mts",
		"./config-markdownlint.mjs",
		"./config-npmpackagejsonlint.d.ts",
		"./config-npmpackagejsonlint.js",
		"./config-prettier.d.ts",
		"./config-prettier.js",
		"./scripts-nodejs.js"
	],
	"scripts": {
		"format": "./scripts-nodejs.js format",
		"lint": "hyperupcall-scripts-nodejs lint"
	},
	"dependencies": {
		"@commitlint/cli": "^21.2.4",
		"@hyperupcall/commitlint-config": "^0.1.3",
		"@hyperupcall/eslint-config": "2.1.0",
		"@hyperupcall/markdownlint-config": "0.5.2",
		"@hyperupcall/npm-package-json-lint-config": "^0.2.0",
		"@hyperupcall/prettier-config": "^0.13.0",
		"eslint": "^10.15.0",
		"prettier": "^3.10.1"
	},
	"devDependencies": {
		"@hyperupcall/scripts-nodejs": "0.13.0",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2"
	},
	"markdownlint-cli2": {
		"extends": "./config-markdownlint.mjs"
	},
	"npmpackagejsonlint": {
		"extends": "./config-npmpackagejsonlint.js"
	},
	"prettier": "./config-prettier.js"
}
