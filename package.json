{
	"name": "@hyperupcall/scripts-nodejs",
	"version": "0.12.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/hyperupcall-projects/scripts-nodejs"
	},
	"bugs": {
		"url": "https://github.com/hyperupcall-projects/scripts-nodejs/issues"
	},
